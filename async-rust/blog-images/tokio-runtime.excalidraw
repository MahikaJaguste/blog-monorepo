    {
      "id": "tlGF20wy033nGYxnbVeId",
      "type": "text",
      "x": -936.8305219253416,
      "y": 58.11850147319967,
      "width": 307.29420481416867,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
